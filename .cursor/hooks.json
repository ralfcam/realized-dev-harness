{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/git-stage-guard.mjs",
        "matcher": "Shell",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/tdd-delegation-guard.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/findings-write-guard.mjs",
        "matcher": "Write",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/task-fanout-guard.mjs",
        "matcher": "Task",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/task-delegation-guard.mjs",
        "matcher": "Task",
        "failClosed": false
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/linear-spawn-guard.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/linear-comment-size-guard.mjs",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/linear-write-guard.mjs",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/after-git-commit.mjs",
        "matcher": "Shell"
      },
      {
        "command": "node .cursor/hooks/repeat-tool-reminder.mjs",
        "failClosed": false
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node .cursor/hooks/repeat-tool-reminder.mjs --failure",
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/task-fanout-guard.mjs --failure",
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/tdd-guard-depth.mjs start"
      },
      {
        "command": "node .cursor/hooks/task-fanout-guard.mjs start"
      },
      {
        "command": "node .cursor/hooks/findings-write-guard.mjs start",
        "matcher": "docs-updater"
      },
      {
        "command": "node .cursor/hooks/linear-write-guard.mjs start",
        "matcher": "linear-resolver"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/tdd-guard-depth.mjs stop"
      },
      {
        "command": "node .cursor/hooks/task-fanout-guard.mjs stop"
      },
      {
        "command": "node .cursor/hooks/findings-write-guard.mjs stop",
        "matcher": "docs-updater"
      },
      {
        "command": "node .cursor/hooks/linear-write-guard.mjs stop",
        "matcher": "linear-resolver"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-docs-sync.mjs",
        "matcher": "Stop",
        "loop_limit": 2
      }
    ]
  }
}
