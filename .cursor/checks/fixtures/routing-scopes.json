      "RES-2",
      "RES-3",
      "RES-4",
      "RES-5"
    ],
    "expectedMetadataScopeIds": ["RES-1", "RES-2", "RES-3", "RES-4", "RES-5"],
    "existingActiveCount": 8,
    "eligibleReadyIds": ["RES-1", "RES-2", "RES-3", "RES-4", "RES-5"],
    "expectedActivationSlots": 2,
    "expectedActivationIds": ["RES-1", "RES-2"],
    "expectedNonWaveIds": ["RES-3", "RES-4", "RES-5"],
    "expectedNonWaveState": "Backlog",
    "expectedNonWaveCycle": null,
    "expectedCloudBehavior": "optional advice only; no assignment, delegation, worktree, or spawn",
    "expectedCardGate": "post-apply Todo/current-cycle re-read"
  },
  {
    "name": "daily activation counts current-cycle Todo toward maximum",
    "command": "dispatch",
    "existingActiveCount": 8,
